{
  "name": "@intuit3d/workflow-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./experimental-plate": {
      "types": "./experimental-plate.d.mts",
      "default": "./experimental-plate.mjs"
    },
    "./local-plate-bridge": {
      "types": "./local-plate-bridge.d.mts",
      "node": "./local-plate-bridge.mjs"
    },
    "./local-plate-client": {
      "types": "./local-plate-client.d.mts",
      "default": "./local-plate-client.mjs"
    },
    "./live-plate-session": {
      "types": "./live-plate-session.d.mts",
      "default": "./live-plate-session.mjs"
    },
    "./persistent-history-source": {
      "types": "./persistent-history-source.d.mts",
      "default": "./persistent-history-source.mjs"
    },
    "./nonocct-step-probe": {
      "types": "./nonocct-step-probe.d.mts",
      "node": "./nonocct-step-probe.mjs"
    }
  },
  "types": "./index.d.mts",
  "peerDependencies": {
    "@intuit3d/model": "0.1.0",
    "@intuit3d/sketch": "0.1.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "typecheck": "tsc --noEmit --strict --allowImportingTsExtensions --module nodenext --moduleResolution nodenext --target es2022 --typeRoots ../../tooling/contract-type-roots test/contract.mts test/bridge-contract.mts test/live-plate-session.contract.mts test/persistent-history-source.contract.mts",
    "demo:native": "node test/experimental-plate.native-demo.mjs",
    "demo:bridge": "node test/local-plate-bridge.native-demo.mjs",
    "demo:occt8:bridge": "node test/local-occt8-bridge.native-demo.mjs",
    "demo:occt8:independent": "node test/local-occt8-bridge.native-demo.mjs --require-independent",
    "demo:occt8:from-empty": "node test/local-occt8-bridge.native-demo.mjs --from-empty",
    "demo:occt8:from-empty:independent": "node test/local-occt8-bridge.native-demo.mjs --from-empty --require-independent"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
