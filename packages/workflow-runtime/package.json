{
  "name": "@intuit3d/workflow-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./experimental-plate": {
      "types": "./experimental-plate.d.mts",
      "default": "./experimental-plate.mjs"
    }
  },
  "types": "./index.d.mts",
  "peerDependencies": {
    "@intuit3d/model": "0.1.0",
