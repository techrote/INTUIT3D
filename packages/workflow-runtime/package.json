  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "typecheck": "tsc --noEmit --strict --allowImportingTsExtensions --module nodenext --moduleResolution nodenext --target es2022 --typeRoots ../../tooling/contract-type-roots test/contract.mts",
    "demo:native": "node test/experimental-plate.native-demo.mjs"
  },
  "engines": {"node": ">=22.6.0"}
