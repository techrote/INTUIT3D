{
  "name": "@intuit3d/interchange",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./dxf/v1": {
      "types": "./dxf.d.mts",
      "default": "./dxf.mjs"
    },
    "./sketch/v1": {
      "types": "./sketch.d.mts",
      "default": "./sketch.mjs"
    },
    "./svg/v1": {
      "types": "./svg.d.mts",
      "default": "./svg.mjs"
    }
  },
  "scripts": {
