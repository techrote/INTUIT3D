{
  "name": "intuit3d-workspace",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "intuit3d-workspace",
      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "devDependencies": {
        "typescript": "5.8.3"
      },
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/@intuit3d/model": {
      "resolved": "packages/model",
      "link": true
    },
    "node_modules/@intuit3d/sketch": {
      "resolved": "packages/sketch",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.8.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.8.3.tgz",
      "integrity": "sha512-p1diW6TqL9L07nNxvRMM7hMMw4c5XOo/1ibL4aAIGmSAt9slTE1Xgw5KWuof2uTOvCg9BY7ZRi+GaF+7sfgPeQ==",
      "dev": true,
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/model": {
      "name": "@intuit3d/model",
      "version": "0.1.0",
      "engines": {
        "node": ">=22.6.0"
      }
    },
    "packages/sketch": {
      "name": "@intuit3d/sketch",
      "version": "0.1.0",
      "engines": {
        "node": ">=22"
      }
    }
  }
}
